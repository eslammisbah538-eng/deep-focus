{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "data.exists() || !root.child('rooms').child($roomCode).exists()",
        ".write": true,
        "createdAt": { ".validate": true },
        "members": {
          "$memberId": {
            ".read": true,
            ".write": true,
            ".validate": "newData.hasChildren(['name','avatarType','status']) || newData.val() == null",
            "name": { 
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" 
            },
            "avatarType": { 
              ".validate": "newData.val() === 'boy' || newData.val() === 'girl'" 
            },
            "status": { 
              ".validate": "newData.val() === 'online' || newData.val() === 'studying' || newData.val() === 'offline'" 
            },
            "lastSeen": { ".validate": true },
            "joinedAt": { ".validate": true },
            "days": { 
              ".read": true, 
              ".write": true,
              "$dateKey": { 
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" 
              }
            }
          }
        }
      }
    }
  }
}